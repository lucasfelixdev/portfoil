# ---------------------------------------------------------------
# Enderecos sem .html
#   lucasfelixdev.com/links   em vez de   lucasfelixdev.com/links.html
#   lucasfelixdev.com/sites   em vez de   lucasfelixdev.com/sites.html
# ---------------------------------------------------------------
RewriteEngine On

# 1) Quem abrir o endereco com .html e redirecionado para o endereco limpo
RewriteCond %{THE_REQUEST} \s/+(.+?)/?index\.html[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) O endereco limpo entrega o arquivo .html correspondente
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
